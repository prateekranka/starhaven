{
  "name": "starhaven-bright-frontier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/release/dist-hashes.mjs && node scripts/release/build-info.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test tests/browser --workers=1",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:no-openai": "node scripts/verify-no-openai.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "release:stage": "node scripts/release/stage-dist.mjs",
    "release:verify-stage": "node scripts/release/verify-staged-dist.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/three": "0.180.0",
    "eslint": "10.8.1",
    "sharp": "0.34.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
